import matplotlib.pyplot as plt
from matplotlib.ticker import FuncFormatter
import pandas as pd
import io

# Load into DataFrame
df = pd.read_csv(io.StringIO(data))

# Define a formatter to convert to "M" format
def millions(x, pos):
    return f'{x*1e-6:.1f}M'

def millions1(x, pos):
    return f'{x*1e-6:.0f}M'

# Define figure size (width, height) in inches
plt.figure(figsize=(8, 4))  # You can adjust these numbers to your preference

# Scatter plot with larger markers and semi-transparency
plt.scatter(
    df['ModelParameters'],
    df['ZKCircuitConstraints'],
    s=90,              # marker size
    alpha=0.8,         # transparency
    edgecolors='black'  # avoid edgecolor warnings
)

# Apply the formatter to both axes
plt.gca().xaxis.set_major_formatter(FuncFormatter(millions))
plt.gca().yaxis.set_major_formatter(FuncFormatter(millions1))

# Labels and title with increased font size
plt.xlabel('Model Parameters', fontsize=14)
plt.ylabel('ZK Circuit Constraints', fontsize=14)
# plt.title('Model Size vs. ZK Constraints (Splt MobileNet Model)', fontsize=16)

# Grid with lighter dashed lines
plt.grid(True, which='both', linestyle='--', linewidth=0.5)

# Increase tick label size
plt.tick_params(axis='both', labelsize=12)

# Tight layout to avoid clipping
plt.tight_layout()

# Show plot
plt.show()
